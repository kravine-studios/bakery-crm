# ──────────────────────────────────────────────
# Bakery CRM — Backend Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bakery_crm
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Logging
LOG_LEVEL=info

# Financial year start month (1=April for Indian FY, 1=January for calendar year)
FY_START_MONTH=4

# Invoice prefix default (can also be configured per-shop in settings)
INVOICE_PREFIX=INV
