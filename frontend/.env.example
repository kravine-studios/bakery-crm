# ──────────────────────────────────────────────────────────────────
# Bakery CRM — Frontend Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env or .env.local to source control.
# ──────────────────────────────────────────────────────────────────

# ── Production API URL ────────────────────────────────────────────
# In local development, leave this UNSET.
# Vite's dev-server proxy (vite.config.ts) will forward /api → localhost:4000.
#
# In production (Vercel, Netlify, etc.), set this to your backend URL,
# WITHOUT a trailing slash and WITHOUT /api.
# Example: VITE_API_URL=https://bakery-crm-api.railway.app
VITE_API_URL=

# ── Demo mode (prototype / showcase) ─────────────────────────────
# Set to "true" when you want to run the frontend without any backend.
# - Login accepts: username=admin, password=demo123 (any password works)
# - All API calls return realistic sample/mock data
# - A "PROTOTYPE DEMO" banner appears on the login page
# - No real data is read or written
# - Real authentication is completely bypassed in this mode
#
# Set to "false" (or leave unset) for normal production use.
# NEVER set this to "true" on a deployment that connects to real data.
VITE_DEMO_MODE=false

# ── Legacy mock mode (local development only) ─────────────────────
# VITE_MOCK=true is the older flag that does the same as VITE_DEMO_MODE.
# Use VITE_DEMO_MODE for Vercel/production demo deployments.
# Use VITE_MOCK=true only for local development without a running backend.
VITE_MOCK=false
